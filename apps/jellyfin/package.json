{
  "name": "valvefin",
  "private": true,
  "version": "0.2.1",
  "author": "AppDev",
  "description": "ValveFin — controller-friendly Jellyfin client for Steam Big Picture",
  "desktopName": "ValveFin.desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "build": {
    "afterPack": "electron/afterPack.cjs",
    "appId": "com.appdev.valvefin",
    "productName": "ValveFin",
    "executableName": "ValveFin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "syncDesktopName": true,
      "target": ["AppImage", "tar.gz"],
      "icon": "public/icon.png",
      "category": "AudioVideo",
      "artifactName": "ValveFin-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "ValveFin",
          "Comment": "Controller-first Jellyfin client for Steam",
          "Categories": "AudioVideo;Video;Player;",
          "StartupWMClass": "ValveFin",
          "Keywords": "Jellyfin;Steam;Video;Music;"
        }
      }
    },
    "appImage": {
      "artifactName": "ValveFin-${version}-x86_64.${ext}"
    },
    "portable": {
      "artifactName": "ValveFin.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ValveFin-Setup-${version}.exe",
      "shortcutName": "ValveFin"
    }
  },
  "dependencies": {
    "hls.js": "^1.6.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/hls.js": "^0.13.3",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
